# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.backup
.env.production
*.env

# Laravel / PHP temporary and dependency directories
/vendor/
/node_modules/
**/vendor/
**/node_modules/

# Laravel Storage & Cache
storage/*.key
storage/pail
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*.log
!**/storage/framework/cache/.gitignore
!**/storage/framework/sessions/.gitignore
!**/storage/framework/views/.gitignore
!**/storage/logs/.gitignore

# SQLite databases (jangan commit database lokal)
*.sqlite
*.sqlite3
*.sqlite-journal
*.db

# Frontend build artifacts
/public/hot
/public/storage
/public/build
**/public/hot
**/public/storage
**/public/build
**/public/fonts-manifest.dev.json

# System & IDE files
.DS_Store
Thumbs.db
*.log
.phpunit.result.cache
.phpunit.cache/
.idea/
.vscode/
.zed/
.nova/
.cursor/
.codex/
